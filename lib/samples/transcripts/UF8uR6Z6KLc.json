  },
  {
    "text": "who want to go to heaven don't want to",
    "startSeconds": 718.04,
    "durationSeconds": 5.359,
    "lang": "en"
  },
  {
    "text": "die to get there and yet death is the",
    "startSeconds": 719.839,
