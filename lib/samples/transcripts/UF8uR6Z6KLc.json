  },
  {
    "text": "cleared away sorry to be so dramatic but",
    "startSeconds": 745.959,
    "durationSeconds": 4.88,
    "lang": "en"
  },
  {
    "text": "it's quite",
    "startSeconds": 749.639,
    "durationSeconds": 4.76,
