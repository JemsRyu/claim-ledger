    "lang": "en"
  },
  {
    "text": "means to say your goodbyes",
    "startSeconds": 657.04,
    "durationSeconds": 6.799,
    "lang": "en"
  },
  {
    "text": "I live with that diagnosis all day later",
    "startSeconds": 660.76,
